# Kuon image
KUON_IMAGE_TAG=latest

# Application
SERVER_PORT=9040
APP_SITE_URL=http://localhost:9040
TRUST_PROXY=false
TZ=Asia/Tokyo

# PostgreSQL
POSTGRES_USER=kuon
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kuon

# Generate a long random secret before starting Kuon.
JWT_SECRET=change-me-to-a-long-random-secret

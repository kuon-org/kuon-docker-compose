# =============================================================================
# Kuon Docker Compose environment
# =============================================================================

# Kuon image
KUON_IMAGE_TAG=latest

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
SERVER_PORT=9040
APP_SITE_URL=http://localhost:9040
TZ=Asia/Tokyo

# Express trust proxy setting.
# false: do not trust proxies (default)
# true: trust all proxies
# 1, 2, ...: trust the specified number of proxy hops
# Express trust proxy values such as "loopback" are also accepted.
TRUST_PROXY=false

# Optional compatibility aliases. APP_SITE_URL is preferred.
# BACKEND_URL=http://localhost:9040
# FRONTEND_URL=http://localhost:9040

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=kuon
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kuon

# Optional database startup retry settings.
# Both values must be positive integers.
# DB_CONNECT_MAX_ATTEMPTS=10
# DB_CONNECT_RETRY_DELAY_MS=3000

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Generate a long random secret before starting Kuon.
JWT_SECRET=change-me-to-a-long-random-secret

# Optional key used to encrypt storage credentials saved from the admin UI.
# When omitted, JWT_SECRET is used.
# STORAGE_SECRET_ENCRYPTION_KEY=change-me-to-another-long-random-secret

# -----------------------------------------------------------------------------
# PlantUML / OGP
# -----------------------------------------------------------------------------
# Custom PlantUML server. When omitted, Kuon uses the official PlantUML server.
# PLANTUML_URL=http://plantuml:8080

# Custom font URL used when rendering OGP images.
# OGP_FONT_URL=https://example.com/fonts/NotoSansJP-Regular.otf

# Optional pg_dump executable override for backup export.
# The official Kuon image already includes PostgreSQL 18 pg_dump.
# PG_DUMP_PATH=/usr/bin/pg_dump

# -----------------------------------------------------------------------------
# Server settings (optional)
# -----------------------------------------------------------------------------
# Environment values override settings stored in the database/admin UI.
# Boolean values accept only true / false.
# KUON_SETTING_ALLOW_API_KEY=false
# KUON_SETTING_ALLOW_LOCAL_ACCOUNT_REGISTRATION=true
# KUON_SETTING_EMAIL_VERIFICATION_POLICY=required
# KUON_SETTING_REQUIRE_TOTP_FOR_EXTERNAL_IDP=false
# KUON_SETTING_REQUIRE_AUTHENTICATION=true
# KUON_SETTING_MAINTENANCE_MODE=false
# KUON_SETTING_WEBHOOKS_ENABLED=false
# KUON_SETTING_ALLOW_USER_WEBHOOKS=false
# KUON_SETTING_NOTIFICATIONS_ENABLED=true

# -----------------------------------------------------------------------------
# Storage (optional)
# -----------------------------------------------------------------------------
# provider: local | s3 | azure
# delivery mode: relay | redirect
# Local storage supports relay only.
# KUON_STORAGE_PROVIDER=local
# KUON_STORAGE_DELIVERY_MODE=relay
# KUON_STORAGE_SIGNED_URL_EXPIRES_IN=300
# KUON_STORAGE_LOCAL_PATH=/app/public/uploads

# S3-compatible storage example (AWS S3, Cloudflare R2, MinIO, etc.)
# KUON_STORAGE_PROVIDER=s3
# KUON_STORAGE_DELIVERY_MODE=redirect
# KUON_STORAGE_SIGNED_URL_EXPIRES_IN=300
# KUON_STORAGE_S3_ENDPOINT=https://example.r2.cloudflarestorage.com
# KUON_STORAGE_S3_REGION=auto
# KUON_STORAGE_S3_BUCKET=kuon
# KUON_STORAGE_S3_ACCESS_KEY_ID=change-me
# KUON_STORAGE_S3_SECRET_ACCESS_KEY=change-me
# KUON_STORAGE_S3_FORCE_PATH_STYLE=false

# Azure Blob Storage example
# KUON_STORAGE_PROVIDER=azure
# KUON_STORAGE_DELIVERY_MODE=redirect
# KUON_STORAGE_SIGNED_URL_EXPIRES_IN=300
# KUON_STORAGE_AZURE_ACCOUNT_NAME=kuon
# KUON_STORAGE_AZURE_ACCOUNT_KEY=change-me
# KUON_STORAGE_AZURE_CONTAINER=kuon
# KUON_STORAGE_AZURE_ENDPOINT=https://kuon.blob.core.windows.net

# -----------------------------------------------------------------------------
# SMTP (optional)
# -----------------------------------------------------------------------------
# KUON_SMTP_HOST=mail.example.com
# KUON_SMTP_PORT=587
# KUON_SMTP_SECURE=false
# KUON_SMTP_USERNAME=kuon
# KUON_SMTP_PASSWORD=change-me
# KUON_SMTP_FROM_ADDRESS=kuon@example.com
# KUON_SMTP_FROM_NAME=Kuon

# -----------------------------------------------------------------------------
# Identity Providers (optional)
# -----------------------------------------------------------------------------
# Format: KUON_IDP__<key>__<FIELD>
# Environment-defined IdPs override database configuration with the same
# provider name. Secrets remain in the environment and are not persisted.

# OAuth2 example: GitHub
# KUON_IDP__github__PROVIDER_NAME=github
# KUON_IDP__github__DISPLAY_NAME=GitHub
# KUON_IDP__github__PROVIDER_TYPE=OAUTH2
# KUON_IDP__github__CLIENT_ID=change-me
# KUON_IDP__github__CLIENT_SECRET=change-me
# KUON_IDP__github__AUTH_URL=https://github.com/login/oauth/authorize
# KUON_IDP__github__TOKEN_URL=https://github.com/login/oauth/access_token
# KUON_IDP__github__USER_INFO_URL=https://api.github.com/user
# KUON_IDP__github__SCOPE=read:user user:email
# KUON_IDP__github__MAPPING={"id":"id","username":"login","display_name":"name"}

# OIDC example
# KUON_IDP__company_oidc__PROVIDER_NAME=oidc-company
# KUON_IDP__company_oidc__DISPLAY_NAME=Company SSO
# KUON_IDP__company_oidc__PROVIDER_TYPE=OIDC
# KUON_IDP__company_oidc__ISSUER_HOST=https://id.example.com
# KUON_IDP__company_oidc__CLIENT_ID=kuon
# KUON_IDP__company_oidc__CLIENT_SECRET=change-me
# KUON_IDP__company_oidc__SCOPE=openid profile email
# KUON_IDP__company_oidc__MAPPING={"id":"sub","username":"preferred_username","display_name":"name"}

# SAML example
# KUON_IDP__keycloak__PROVIDER_NAME=saml-keycloak
# KUON_IDP__keycloak__DISPLAY_NAME=Keycloak
# KUON_IDP__keycloak__PROVIDER_TYPE=SAML
# KUON_IDP__keycloak__ISSUER=kuon
# KUON_IDP__keycloak__ENTRY_POINT=https://id.example.com/realms/kuon/protocol/saml
# KUON_IDP__keycloak__CERT=change-me
# KUON_IDP__keycloak__WANT_ASSERTIONS_SIGNED=true
# KUON_IDP__keycloak__WANT_AUTHN_RESPONSE_SIGNED=false
# KUON_IDP__keycloak__DISABLE_REQUESTED_AUTHN_CONTEXT=false
# KUON_IDP__keycloak__CLOCK_SKEW_SECONDS=0
# KUON_IDP__keycloak__REQUEST_ID_EXPIRATION_MS=28800000
# KUON_IDP__keycloak__MAPPING={"id":"nameID","username":"email","display_name":"displayName"}

# Optional explicit callback/redirect URI override for an IdP.
# Normally Kuon derives this from APP_SITE_URL and PROVIDER_NAME.
# KUON_IDP__company_oidc__REDIRECT_URI=https://kuon.example.com/auth/oidc-company/callback
